# Copiá este archivo como .env (python run.py setup lo hace por vos) y completá los valores.
# .env está en el .gitignore: nunca lo subas.

# --- API de origen ---
# Opción A, API local incluida en el repo (api/main.py): levantala con
#   python -m uvicorn api.main:app --port 8000
# y usá cualquier token largo: la API exige el mismo valor que pongas acá.
API_URL=http://127.0.0.1:8000
API_TOKEN=
# Opción B, API pública del template: https://api-datos.mauroprystupa.com (token personal en mauroprystupa.com/proyecto)
# Límite de pedidos por minuto de la API local (opcional, default 30)
# API_RATE_LIMIT_POR_MINUTO=30

# --- BigQuery ---
GCP_PROJECT=
BQ_LOCATION=US
# service-account (con la clave JSON de abajo, guardada FUERA del repo)
# u oauth (si ya corriste `gcloud auth application-default login`)
BQ_METHOD=service-account
GOOGLE_APPLICATION_CREDENTIALS=
